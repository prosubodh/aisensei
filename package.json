{
  "name": "aisensei",
  "version": "1.0.0",
  "description": "Pedagogical governance toolkit and deep learning workspace for AI-assisted mastery",
  "type": "module",
  "bin": {
    "aisensei": "bin/aisensei.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "scripts",
    "docs",
    ".agents",
    ".tutor",
    "exercises",
    "notes",
    "projects",
    "AGENTS.md",
    "memory.md",
    "README.md",
    ".gitignore",
    ".editorconfig",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "keywords": [
    "ai-tutor",
    "deep-learning",
    "pedagogy",
    "first-principles",
    "socratic-method",
    "bloom-taxonomy",
    "learning-governance",
    "agentic-learning",
    "spaced-repetition",
    "scaffolding",
    "npx"
  ],
  "author": "Subodh Khanal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosubodh/aisensei.git"
  },
  "bugs": {
    "url": "https://github.com/prosubodh/aisensei/issues"
  },
  "homepage": "https://github.com/prosubodh/aisensei#readme",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-cli.js",
    "prepublishOnly": "npm run build && npm run test:coverage && npm run validate"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "typescript": "5.7.3"
  }
}
